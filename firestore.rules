rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /onboarding/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /achievements/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /goals/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /journal_entries/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /anxiety_entries/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /ai_analyses/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /thought_records/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /breathing_exercises/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meditation_completions/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meditation_sessions/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
